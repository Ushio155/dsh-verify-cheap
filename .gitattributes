# Keep LF in the repository and in every checkout: the bundled scripts carry
# shebangs and are meant to run on POSIX too, and CRLF would break that.
* text=auto eol=lf

# Images (none today) would be corrupted by any text filter.
*.png binary
*.jpg binary
*.gif binary

# Harness console logs under research/ are UTF-16LE (PowerShell redirection):
# never let a text filter near them.
research/trigger-ab/results/*.log binary
